# Jarvis runtime
JARVIS_BACKEND=llm_vm
JARVIS_USER_NAME=Operator
JARVIS_TIME_ZONE=UTC

# Local or LAN LLM server. Ollama exposes an OpenAI-compatible API at /v1.
JARVIS_LLM_VM_HOST=127.0.0.1
JARVIS_LLM_VM_USER=jarvis
JARVIS_LLM_VM_BASE_URL=http://127.0.0.1:11434/v1
JARVIS_LLM_VM_API_KEY=not-needed
JARVIS_MODEL=llama3.2:3b
JARVIS_LLM_VM_TIMEOUT_SECONDS=180
JARVIS_LLM_VM_KEEP_ALIVE=30m

# Optional SSH inspection
# JARVIS_LLM_VM_PASSWORD=
# JARVIS_LLM_VM_KEY_PATH=C:\Users\you\.ssh\id_ed25519
JARVIS_LLM_VM_ALLOW_AGENT=1

# Local microphone verification only
JARVIS_RECORD_SECONDS=5
JARVIS_SAMPLE_RATE=16000

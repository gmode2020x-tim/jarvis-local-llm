PORT=8787
DATA_DIR=./data
JARVIS_CONVERSATION_ARCHIVE_PATH=conversation-archive.jsonl
APP_NAME=jarvis-llm-ui
PUBLIC_BASE_URL=http://YOUR-LLM-HOST:8787

# Ollama
OLLAMA_HOST=http://127.0.0.1:11434
DEFAULT_MODEL=llama3.2:3b
VOICE_MODEL=llama3.2:3b
DEEP_MODEL=llama3.1:8b
DEFAULT_MAX_TOKENS=160
VOICE_MAX_TOKENS=64
DEEP_MAX_TOKENS=512
OLLAMA_TIMEOUT_MS=120000
OLLAMA_KEEP_ALIVE=30m

# Jarvis persona
JARVIS_USER_NAME=Operator
JARVIS_TIME_ZONE=UTC
JARVIS_SYSTEM_PROMPT=You are Jarvis, a private local assistant. Be calm, precise, conversational, dryly witty, and useful. Lead with the answer, use the configured name occasionally rather than in every reply, and never force a joke onto routine facts or invent live facts and completed actions.
JARVIS_VOICE_SYSTEM_PROMPT=You are Jarvis, a private local voice assistant. Keep replies natural and concise. Use the configured name occasionally, allow routine factual answers to be plain, and use sarcasm only when it fits. Never invent live facts or completed actions.

# Optional Home Assistant
HOME_ASSISTANT_URL=http://homeassistant.local:8123
HOME_ASSISTANT_TOKEN=
HOME_ASSISTANT_WEBHOOK_SECRET=change-this-long-random-secret
HOME_ASSISTANT_CORS_ORIGINS=http://homeassistant.local:8123
JARVIS_TTS_ENTITY=tts.piper
JARVIS_DEFAULT_SPEAKER=
JARVIS_TTS_LANGUAGE=
JARVIS_TTS_VOICE=
